generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum AttendanceMethod {
  QUICK
  PROJECT
  GPS
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  EXCUSE
}

// ==========================================
// نماذج المنصة السحابية وتعدد الأنشطة (SAAS & TENANCY)
// ==========================================

model Tenant {
  id               String            @id @default("default-tenant")
  name             String            @default("النشاط الرئيسي")
  slug             String            @unique @default("main")
  customDomain     String?           @unique
  logo             String?
  phone            String?
  managerName      String?
  managerPhone     String?
  status           TenantStatus      @default(ACTIVE)
  trialEndsAt      DateTime?
  
  planId           String?
  plan             SubscriptionPlan? @relation(fields: [planId], references: [id])
  subscriptions    Subscription[]

  // العلاقات مع بيانات النشاط التجاري
  companySettings  CompanySettings?
  users            User[]
  departments      Department[]
  projects         Project[]
  rateRules        RateRule[]
  pharmacyProducts PharmacyProduct[]
  pharmacySuppliers PharmacySupplier[]
  purchasingTrips  PurchasingTrip[]
  inventoryAudits  InventoryAudit[]
  shortageRequests WhatsAppShortageRequest[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([slug])
  @@index([status])
}

model SubscriptionPlan {
  id                  String         @id @default(uuid())
  name                String         // أساسية / احترافية / مؤسسية
  code                String         @unique // BASIC / PRO / ENTERPRISE
  description         String?
  priceMonthly        Float          @default(0.0) // بالدينار (د.ل)
  priceYearly         Float          @default(0.0) // بالدينار (د.ل)
  
  // قيود الاستخدام
  maxEmployees        Int            @default(10)
  maxBranches         Int            @default(1)
  maxProducts         Int            @default(1000)
  
  // الميزات الحصرية
  hasAdvancedOcr      Boolean        @default(false)
  hasWhatsAppAlerts   Boolean        @default(false)
  hasInventoryPredict Boolean        @default(false)
  
  isActive            Boolean        @default(true)
  tenants             Tenant[]
  subscriptions       Subscription[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Subscription {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId          String
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  billingCycle    BillingCycle     @default(MONTHLY)
  startDate       DateTime         @default(now())
  endDate         DateTime
  amountPaid      Float            @default(0.0) // بالدينار (د.ل)
  paymentMethod   String?          // CASH / BANK_TRANSFER / CARD
  referenceNumber String?          // رقم إيصال الدفع أو الحوالة
  isActive        Boolean          @default(true)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId])
  @@index([endDate])
}

model Department {
  id        String    @id @default(uuid())
  tenantId  String    @default("default-tenant")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  jobRoles  JobRole[]
  users     User[]    @relation("UserDepartments")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model JobRole {
  id                 String             @id @default(uuid())
  title              String
  monthlySalary      Float              @default(0.0) // الراتب الشهري المحدد للوظيفة
  targetMonthlyHours Float              @default(0.0) // ساعات الوظيفة المطلوبة في الشهر (0 إذا لم تحدد)
  isHourly           Boolean            @default(true)  // true: مرتبطة بساعات | false: راتب شهري ثابت
  hasCommission      Boolean            @default(false) // تفعيل عمولة المبيعات / المشتريات
  commissionType     String             @default("SALES") // "SALES" | "PURCHASES"
  commissionRate     Float              @default(0.0) // نسبة العمولة % (مثلاً 2.5)
  departmentId       String
  department         Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users              User[]             @relation("UserJobRoles")
  attendances        AttendanceRecord[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([departmentId, title])
}

model Project {
  id           String             @id @default(uuid())
  tenantId     String             @default("default-tenant")
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  clientName   String?
  hourlyRate   Float              @default(0.0)
  budgetHours  Float              @default(0.0)
  color        String             @default("#0284c7")
  attendances  AttendanceRecord[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([tenantId])
}

model User {
  id                 String             @id @default(uuid())
  tenantId           String             @default("default-tenant")
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeCode       String
  name               String
  email              String
  password           String             @default("")
  role               UserRole           @default(EMPLOYEE)
  avatar             String?
  phone              String?
  jobTitle           String
  departments        Department[]       @relation("UserDepartments")
  jobRoles           JobRole[]          @relation("UserJobRoles")
  monthlySalary      Float              @default(0.0) // الراتب الشهري للوظيفة
  targetMonthlyHours Float              @default(0.0) // ساعات الوظيفة بالشهر
  hourlyRate         Float              @default(0.0)   // أجر الساعة المباشر
  attendances        AttendanceRecord[]
  leaves             LeaveRequest[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, email])
  @@index([tenantId])
}

model AttendanceRecord {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobRoleId        String?
  jobRole          JobRole?         @relation(fields: [jobRoleId], references: [id])
  date             String           // YYYY-MM-DD
  checkInTime      String           // HH:mm:ss
  checkOutTime     String?          // HH:mm:ss
  workHours        Float            @default(0.0)
  earnedCost       Float            @default(0.0)
  shiftAmount      Float            @default(0.0) // قيمة مبيعات/مشتريات الوردية (د.ل)
  shiftAmountType  String?          // "SALES" | "PURCHASES"
  commissionRate   Float            @default(0.0) // نسبة العمولة %
  commissionAmount Float            @default(0.0) // قيمة العمولة المحتسبة للوردية (د.ل)
  isVerified       Boolean          @default(false) // توثيق الاعتماد من المدير
  verifiedAt       DateTime?        // تاريخ ووقت التوثيق
  checkInLat       Float?
  checkInLng       Float?
  checkOutLat      Float?
  checkOutLng      Float?
  isOutsideGps     Boolean          @default(false) // تم التسجيل خارج نطاق GPS
  projectId        String?
  project          Project?         @relation(fields: [projectId], references: [id])
  projectName      String?
  taskNotes        String?
  attachments      Attachment[]
  method           AttendanceMethod @default(QUICK)
  createdAt        DateTime         @default(now())
}

model Attachment {
  id           String           @id @default(uuid())
  attendanceId String
  attendance   AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  fileType     String
  createdAt    DateTime         @default(now())
}

model LeaveRequest {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      LeaveType
  startDate String
  endDate   String
  reason    String
  status    LeaveStatus @default(PENDING)
  createdAt DateTime    @default(now())
}

model CompanySettings {
  id                        String   @id @default("default")
  tenantId                  String   @unique @default("default-tenant")
  tenant                    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyName               String   @default("نظام تدوين ساعات العمل المخصص")
  logoUrl                   String?
  managerPhone              String?  @default("")
  n8nWebhookUrl             String   @default("https://n8n.ordermt.ly/webhook/attendance-alert")
  whatsappNotificationsEnabled Boolean @default(true)
  defaultTargetMonthlyHours Float    @default(0.0)
  autoCloseHours            Float    @default(12.0)
  gpsEnabled                Boolean  @default(false)
  gpsLatitude               Float?   @default(32.8872)
  gpsLongitude              Float?   @default(13.1913)
  gpsRadiusMeters           Int      @default(200)
  updatedAt                 DateTime @updatedAt
}

enum RuleType {
  RECURRING
  ONE_TIME
}

enum RateIncreaseType {
  PERCENTAGE
  FIXED_AMOUNT
}

model RateRule {
  id           String           @id @default(uuid())
  tenantId     String           @default("default-tenant")
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  ruleType     RuleType         @default(RECURRING)
  daysOfWeek   Int[]            // [0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat]
  specificDate String?          // YYYY-MM-DD for ONE_TIME
  startTime    String?          // HH:mm (e.g. "00:00")
  endTime      String?          // HH:mm (e.g. "08:00" or "24:00")
  increaseType RateIncreaseType @default(PERCENTAGE)
  value        Float            // e.g. 50 (for 50%) or 3.5 (for +3.5 LYD/hr)
  appliesTo    String           @default("ALL") // "ALL" | "DEPARTMENT" | "EMPLOYEE"
  targetId     String?          // departmentId or userId
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([tenantId])
}

// ==========================================
// منظومة المشتريات والمخزون الصيدلاني (PHARMACY)
// ==========================================

model PharmacyProduct {
  id               Int      @id @default(autoincrement())
  tenantId         String   @default("default-tenant")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchCode       String   @default("MAIN_BRANCH") // كود الفرع أو مصدر البيانات
  branchName       String?  @default("الفرع الرئيسي")
  productCode      String
  productName      String
  stockOnHand      Float    @default(0.0)
  minStockLevel    Float    @default(0.0)
  maxStockLevel    Float    @default(0.0)
  costPrice        Float    @default(0.0)
  sellPrice        Float    @default(0.0)
  totalSoldQty     Float    @default(0.0)
  sold30Days       Float    @default(0.0) // مبيعات آخر 30 يوماً
  sold60Days       Float    @default(0.0) // مبيعات آخر 60 يوماً
  sold90Days       Float    @default(0.0) // مبيعات آخر 90 يوماً
  sold180Days      Float    @default(0.0) // مبيعات آخر 180 يوماً
  inStockDays      Float    @default(30.0) // عدد الأيام التي كان فيها المخزون متوفراً لقياس سرعة السحب الحقيقية
  inventoryUnit    String?  @default("قطعة") // الوحدة الصغرى للمخزون
  orderUnit        String?  @default("عبوة") // الوحدة الكبرى لطلب الشراء
  packSize         Float    @default(1.0) // معامل التحويل (كم وحدة صغرى داخل الوحدة الكبرى)
  purchaseUnitCost Float    @default(0.0) // تكلفة شراء الوحدة الكبرى
  expiryDate       String?
  supplierId       Int?
  supplierName     String?
  groupName        String?
  category         String?  // MEDICINES | MOTHER_BABY | COSMETICS_CARE | MEDICAL_EQUIPMENT | SUPPLEMENTS
  subCategory      String?
  activeIngredient String?
  strength         String?
  dosageForm       String?
  genericGroupId   String?
  barcodes         String?  // الباركودات المتعددة والبديلة مفصولة بفواصل
  lastSalesDate    String?
  lastSyncedAt     DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, productCode, branchCode])
  @@index([tenantId])
}

model PharmacySupplier {
  id                 Int      @id @default(autoincrement())
  tenantId           String   @default("default-tenant")
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchCode         String   @default("MAIN_BRANCH")
  branchName         String?  @default("الفرع الرئيسي")
  supplierIdPk       Int
  name               String
  code               String?
  phone              String?
  mobile             String?
  address            String?
  totalPurchases     Float    @default(0.0)
  totalInvoicesCount Int      @default(0)
  outstandingBalance Float    @default(0.0)
  lastSyncedAt       DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, supplierIdPk, branchCode])
  @@index([tenantId])
}

model PurchasingTrip {
  id                  String   @id @default(uuid())
  tenantId            String   @default("default-tenant")
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  officerId           String?
  officerName         String
  date                String   // YYYY-MM-DD
  startTime           String   // HH:mm
  endTime             String?  // HH:mm
  suppliersVisited    Json?    // ["شركة أ", "مستودع ب"]
  totalInvoicesAmount Float    @default(0.0)
  commissionEarned    Float    @default(0.0)
  status              String   @default("COMPLETED")
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
}

model InventoryAudit {
  id                String   @id @default(uuid())
  tenantId          String   @default("default-tenant")
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  officerId         String?
  officerName       String
  date              String   // YYYY-MM-DD
  sectionAudited    String
  totalItemsChecked Int      @default(0)
  matchedCount      Int      @default(0)
  discrepancyCount  Int      @default(0)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
}

model PharmacySettings {
  id                       String   @id @default("default")
  criticalExpiryDays       Int      @default(30)
  warningExpiryDays        Int      @default(90)
  attentionExpiryDays      Int      @default(180)
  purchasingCommissionRate Float    @default(0.5)
  syncApiKey               String   @default("PHARMACY_SYNC_KEY_2026")
  pharmacyName             String   @default("صيدلية النقاء")
  lastSyncTimestamp        DateTime?
  updatedAt                DateTime @updatedAt
}

model ClinicalDrugReference {
  id                           String   @id @default(uuid())
  brandPattern                 String   @unique // كود/نمط المطابقة مثلاً: "colona", "librax"
  brandName                    String   // الاسم التجاري
  activeIngredients            String   // التركيبة الكيميائية النقية
  therapeuticClass             String   // الفئة والتصنيف الدوائي
  indications                  String   // دواعي الاستعمال
  dosageAndAdmin               String   // طريقة الاستخدام والجرعة
  majorInteractions            String[] // أهم التداخلات الدوائية
  warningsAndContraindications String[] // موانع وتحذيرات هامة
  patientCounselingTip         String   // نصيحة الصرف للمريض
  drugBankId                   String?  @default("")
  drugBankUrl                  String?  @default("")
  sourceReference              String?  @default("EMC UK • EDA • SFDA • Drugs.com")
  isCustom                     Boolean  @default(false) // مضاف أو معدل يدوياً
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model WhatsAppShortageRequest {
  id               String   @id @default(uuid())
  tenantId         String   @default("default-tenant")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chatId           String?  // e.g. "12036302@g.us" or sender phone
  groupName        String?  // اسم المجموعة إن وجد
  senderName       String?  // اسم العضو المرسل
  senderPhone      String?  // رقم هاتف المرسل
  rawMessage       String   // النص الأصلي للرسالة
  productName      String   // اسم الصنف المستخرج
  matchedCode      String?  // كود الصنف المطابق في المنظومة
  activeIngredient String?  // المادة الفعالة
  requestedQty     Float?   // الكمية المطلوبة (فارغة في حال عدم ذكرها صراحة ليحددها مسؤول المشتريات)
  unit             String?  @default("عبوة")
  urgency          String   @default("HIGH") // CRITICAL | HIGH | MEDIUM | LOW
  status           String   @default("PENDING") // PENDING | ORDERED | RECEIVED | CANCELLED
  source           String   @default("WHATSAPP_GROUP")
  imageUrl         String?  // رابط أو Base64 لصورة العلبة أو الروشتة المرفقة
  mediaType        String?  // IMAGE | DOCUMENT | TEXT
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([productName])
  @@index([createdAt])
}

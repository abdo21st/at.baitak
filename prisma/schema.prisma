generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum AttendanceMethod {
  QUICK
  PROJECT
  GPS
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  EXCUSE
}

model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String?
  jobRoles  JobRole[]
  users     User[]    @relation("UserDepartments")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model JobRole {
  id                 String             @id @default(uuid())
  title              String
  monthlySalary      Float              @default(500.0) // الراتب الشهري المحدد للوظيفة
  targetMonthlyHours Float              @default(160.0) // ساعات الوظيفة المطلوبة في الشهر
  isHourly           Boolean            @default(true)  // true: مرتبطة بساعات | false: راتب شهري ثابت
  departmentId       String
  department         Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users              User[]             @relation("UserJobRoles")
  attendances        AttendanceRecord[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([departmentId, title])
}

model Project {
  id           String             @id @default(uuid())
  name         String
  clientName   String?
  hourlyRate   Float              @default(0.0)
  budgetHours  Float              @default(0.0)
  color        String             @default("#0284c7")
  attendances  AttendanceRecord[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model User {
  id                 String             @id @default(uuid())
  employeeCode       String             @unique
  name               String
  email              String             @unique
  password           String             @default("123456")
  role               UserRole           @default(EMPLOYEE)
  avatar             String?
  phone              String?
  jobTitle           String
  departments        Department[]       @relation("UserDepartments")
  jobRoles           JobRole[]          @relation("UserJobRoles")
  monthlySalary      Float              @default(500.0) // الراتب الشهري للوظيفة
  targetMonthlyHours Float              @default(160.0) // ساعات الوظيفة بالشهر
  hourlyRate         Float              @default(0.0)   // أجر الساعة المستنتج
  attendances        AttendanceRecord[]
  leaves             LeaveRequest[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model AttendanceRecord {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobRoleId    String?
  jobRole      JobRole?         @relation(fields: [jobRoleId], references: [id])
  date         String           // YYYY-MM-DD
  checkInTime  String           // HH:mm:ss
  checkOutTime String?          // HH:mm:ss
  workHours    Float            @default(0.0)
  earnedCost   Float            @default(0.0) // Calculated (workHours * monthlySalary) / targetMonthlyHours
  isVerified   Boolean          @default(false) // توثيق الاعتماد من المدير
  verifiedAt   DateTime?        // تاريخ ووقت التوثيق
  checkInLat   Float?
  checkInLng   Float?
  checkOutLat  Float?
  checkOutLng  Float?
  isOutsideGps Boolean          @default(false) // تم التسجيل خارج نطاق GPS
  projectId    String?
  project      Project?         @relation(fields: [projectId], references: [id])
  projectName  String?
  taskNotes    String?
  attachments  Attachment[]
  method       AttendanceMethod @default(QUICK)
  createdAt    DateTime         @default(now())
}

model Attachment {
  id           String           @id @default(uuid())
  attendanceId String
  attendance   AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  fileType     String
  createdAt    DateTime         @default(now())
}

model LeaveRequest {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      LeaveType
  startDate String
  endDate   String
  reason    String
  status    LeaveStatus @default(PENDING)
  createdAt DateTime    @default(now())
}

model CompanySettings {
  id                        String   @id @default("default")
  companyName               String   @default("نظام تدوين ساعات العمل المخصص")
  logoUrl                   String?
  managerPhone              String?  @default("")
  n8nWebhookUrl             String   @default("https://n8n.ordermt.ly/webhook/attendance-alert")
  whatsappNotificationsEnabled Boolean @default(true)
  defaultTargetMonthlyHours Float    @default(160.0)
  autoCloseHours            Float    @default(12.0)
  gpsEnabled                Boolean  @default(false)
  gpsLatitude               Float?   @default(32.8872)
  gpsLongitude              Float?   @default(13.1913)
  gpsRadiusMeters           Int      @default(200)
  updatedAt                 DateTime @updatedAt
}
